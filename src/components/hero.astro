---
---
<section style="position: relative; padding: 4rem 0 5rem 0; margin: 0 auto;">
  
  <!-- Slides Container -->
  <div id="hero-slider" style="position: relative; overflow: hidden; min-height: 400px;">
    
    <!-- Slide 1 -->
    <div class="hero-slide" style="transition: opacity 0.5s ease; opacity: 1; position: relative; display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center;">
      <div>
        <p style="color: var(--accent); font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem;">
          <span class="en-text">Latest Updates</span>
          <span class="as-text">শেহতীয়া আপডেট</span>
        </p>
        <h1 style="font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 800; line-height: 1.1; letter-spacing: -1px; margin: 0 0 1.5rem 0; color: var(--text-main);">
          <span class="en-text">Building for Assam,<br/>for the Future.</span>
          <span class="as-text">অসমৰ বাবে,<br/>ভৱিষ্যতৰ বাবে।</span>
        </h1>
        <p style="color: var(--text-muted); font-size: clamp(1.1rem, 2.5vw, 1.3rem); margin: 0; line-height: 1.6;">
          <span class="en-text">Independent developer building AI-first tools and education platforms for the people of Assam.</span>
          <span class="as-text">অসমৰ ৰাইজৰ বাবে AI-চালিত সঁজুলি আৰু শৈক্ষিক প্লেটফৰ্ম নিৰ্মাণ কৰা এজন স্বতন্ত্ৰ ডেভেলপাৰ।</span>
        </p>
      </div>
      <div>
        <img src="/hero/jhapi.jpg" alt="Assam Landscape" style="width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; border-radius: 16px; border: 1px solid var(--card-border); box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);" />
      </div>
    </div>

    <!-- Slide 2 (Hidden by default) -->
    <div class="hero-slide" style="transition: opacity 0.5s ease; opacity: 0; display: none; position: absolute; top: 0; left: 0; width: 100%; grid-template-columns: 1fr; gap: 2rem; align-items: center;">
      <div>
        <p style="color: var(--accent); font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem;">
          <span class="en-text">Empowering Students</span>
          <span class="as-text">শিক্ষাৰ্থীক সৱলীকৰণ</span>
        </p>
        <h1 style="font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 800; line-height: 1.1; letter-spacing: -1px; margin: 0 0 1.5rem 0; color: var(--text-main);">
          <span class="en-text">Bridging the gap in<br/>local education.</span>
          <span class="as-text">স্থানীয় শিক্ষাৰ ব্যৱধান<br/>দূৰ কৰা।</span>
        </h1>
        <p style="color: var(--text-muted); font-size: clamp(1.1rem, 2.5vw, 1.3rem); margin: 0; line-height: 1.6;">
          <span class="en-text">Creating accessible, AI-driven learning tools that understand our language and culture.</span>
          <span class="as-text">আমাৰ ভাষা আৰু সংস্কৃতি বুজি পোৱা, সুলভ আৰু AI-চালিত শিকন সঁজুলি সৃষ্টি কৰা।</span>
        </p>
      </div>
      <div>
        <img src="/hero/rhino.jpg" alt="One-horned Rhino" style="width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; border-radius: 16px; border: 1px solid var(--card-border); box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);" />
      </div>
    </div>

    <!-- Slide 3 (Hidden by default) -->
    <div class="hero-slide" style="transition: opacity 0.5s ease; opacity: 0; display: none; position: absolute; top: 0; left: 0; width: 100%; grid-template-columns: 1fr; gap: 2rem; align-items: center;">
      <div>
        <p style="color: var(--accent); font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem;">
          <span class="en-text">Open Source</span>
          <span class="as-text">মুকলিত উৎস</span>
        </p>
        <h1 style="font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 800; line-height: 1.1; letter-spacing: -1px; margin: 0 0 1.5rem 0; color: var(--text-main);">
          <span class="en-text">Code. Not Noise.<br/>Real Output.</span>
          <span class="as-text">ক’ড। মাত্ৰ শব্দ নহয়।<br/>প্ৰকৃত ফলাফল।</span>
        </h1>
        <p style="color: var(--text-muted); font-size: clamp(1.1rem, 2.5vw, 1.3rem); margin: 0; line-height: 1.6;">
          <span class="en-text">Building tools in the open. Follow my journey on GitHub and see what's next.</span>
          <span class="as-text">মুকলিতভাৱে সঁজুলি নিৰ্মাণ কৰা। GitHub-ত মোৰ যাত্ৰা অনুসৰণ কৰক আৰু চাওক পৰৱৰ্তী কি।</span>
        </p>
      </div>
      <div>
        <img src="/hero/tradition.jpg" alt="Assamese Tradition" style="width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; border-radius: 16px; border: 1px solid var(--card-border); box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);" />
      </div>
    </div>

  </div>

  <!-- Navigation Arrows -->
  <div style="display: flex; gap: 1rem; margin-top: 2rem; justify-content: center;">
    <button id="hero-prev" style="background: white; border: 1px solid var(--card-border); color: var(--text-main); width: 48px; height: 48px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: all 0.2s; box-shadow: 0 2px 5px rgba(0,0,0,0.05);" onmouseover="this.style.background='#f0f2f5'" onmouseout="this.style.background='white'">
      ←
    </button>
    <button id="hero-next" style="background: white; border: 1px solid var(--card-border); color: var(--text-main); width: 48px; height: 48px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: all 0.2s; box-shadow: 0 2px 5px rgba(0,0,0,0.05);" onmouseover="this.style.background='#f0f2f5'" onmouseout="this.style.background='white'">
      →
    </button>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .hero-slide {
      grid-template-columns: 1fr 1fr !important;
    }
  }
</style>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  const prevBtn = document.getElementById('hero-prev');
  const nextBtn = document.getElementById('hero-next');
  let currentSlide = 0;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.style.display = window.innerWidth >= 768 ? 'grid' : 'block';
        setTimeout(() => slide.style.opacity = '1', 20);
      } else {
        slide.style.opacity = '0';
        setTimeout(() => slide.style.display = 'none', 300);
      }
    });
  }

  window.addEventListener('resize', () => {
    slides.forEach((slide, i) => {
      if (i === currentSlide && slide.style.display !== 'none') {
        slide.style.display = window.innerWidth >= 768 ? 'grid' : 'block';
      }
    });
  });

  prevBtn.addEventListener('click', () => {
    currentSlide = (currentSlide - 1 + slides.length) % slides.length;
    showSlide(currentSlide);
  });

  nextBtn.addEventListener('click', () => {
    currentSlide = (currentSlide + 1) % slides.length;
    showSlide(currentSlide);
  });
</script>