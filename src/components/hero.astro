---
export interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
---
<section class="relative py-16 md:py-20 w-full max-w-[1000px] mx-auto">
  
  <!-- Slides Container -->
  <div id="hero-slider" class="relative overflow-hidden min-h-[500px] rounded-3xl shadow-[0_20px_40px_-10px_rgba(0,0,0,0.15)]">
    
    <!-- Slide 1 -->
    <div class="hero-slide transition-opacity duration-500 opacity-100 absolute inset-0 flex items-center p-8 md:p-12">
      <img src="/hero/jhapi.jpg" alt="Assam Landscape" class="absolute inset-0 w-full h-full object-cover z-0" />
      
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-black/10 z-10"></div>
      
      <div class="relative z-20 max-w-[600px] text-white">
        <h1 class="text-[2.5rem] md:text-[4rem] font-extrabold leading-[1.1] tracking-tight mb-6">
          {lang === 'as' ? (
            <Fragment>অসমৰ বাবে,<br/>ভৱিষ্যতৰ বাবে।</Fragment>
          ) : (
            <Fragment>Building for Assam,<br/>for the Future.</Fragment>
          )}
        </h1>
        <p class="text-white/95 text-lg md:text-xl leading-relaxed m-0">
          {lang === 'as'
            ? 'অসমৰ ৰাইজৰ বাবে AI-চালিত সঁজুলি আৰু শৈক্ষিক প্লেটফৰ্ম নিৰ্মাণ কৰা এজন স্বতন্ত্ৰ ডেভেলপাৰ।'
            : 'Independent developer building AI-first tools and education platforms for the people of Assam.'}
        </p>
      </div>
    </div>

    <!-- Slide 2 -->
    <div class="hero-slide transition-opacity duration-500 opacity-0 absolute inset-0 hidden items-center p-8 md:p-12">
      <img src="/hero/rhino.jpg" alt="One-horned Rhino" class="absolute inset-0 w-full h-full object-cover z-0" />
      
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-black/10 z-10"></div>
      
      <div class="relative z-20 max-w-[600px] text-white">
        <p class="text-[#00E1FF] font-bold text-sm uppercase tracking-wider mb-4">
          {lang === 'as' ? 'শিক্ষাৰ্থীক সৱলীকৰণ' : 'Empowering Students'}
        </p>
        <h1 class="text-[2.5rem] md:text-[4rem] font-extrabold leading-[1.1] tracking-tight mb-6">
          {lang === 'as' ? (
            <Fragment>স্থানীয় শিক্ষাৰ ব্যৱধান<br/>দূৰ কৰা।</Fragment>
          ) : (
            <Fragment>Bridging the gap in<br/>local education.</Fragment>
          )}
        </h1>
        <p class="text-white/95 text-lg md:text-xl leading-relaxed m-0">
          {lang === 'as'
            ? 'আমাৰ ভাষা আৰু সংস্কৃতি বুজি পোৱা, সুলভ আৰু AI-চালিত শিকন সঁজুলি সৃষ্টি কৰা।'
            : 'Creating accessible, AI-driven learning tools that understand our language and culture.'}
        </p>
      </div>
    </div>

    <!-- Slide 3 -->
    <div class="hero-slide transition-opacity duration-500 opacity-0 absolute inset-0 hidden items-center p-8 md:p-12">
      <img src="/hero/paddy.jpg" alt="Assamese Culture" class="absolute inset-0 w-full h-full object-cover z-0" />
      
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-black/10 z-10"></div>
      
      <div class="relative z-20 max-w-[600px] text-white">
        <p class="text-[#00E1FF] font-bold text-sm uppercase tracking-wider mb-4">
          {lang === 'as' ? 'মুকলিত উৎস' : 'Open Source'}
        </p>
        <h1 class="text-[2.5rem] md:text-[4rem] font-extrabold leading-[1.1] tracking-tight mb-6">
          {lang === 'as' ? (
            <Fragment>ক'ড। মাত্ৰ শব্দ নহয়।<br/>প্ৰকৃত ফলাফল।</Fragment>
          ) : (
            <Fragment>Code. Not Noise.<br/>Real Output.</Fragment>
          )}
        </h1>
        <p class="text-white/95 text-lg md:text-xl leading-relaxed m-0">
          {lang === 'as'
            ? 'মুকলিতভাৱে সঁজুলি নিৰ্মাণ কৰা। Social Media-ত মোৰ যাত্ৰা অনুসৰণ কৰক আৰু চাওক পৰৱৰ্তী কি।'
            : "Building tools in the open. Follow my journey to see what's next."}
        </p>

        <!-- Social icons -->
        <div class="flex gap-3 items-center mt-8">
          <a href="https://github.com/axomiyaindie" target="_blank" rel="noopener" class="hero-social-icon" title="GitHub">
            <img src="/social/github.png" alt="GitHub" width="20" height="20" />
          </a>
          <a href="https://www.linkedin.com/in/axomiyaindie/" target="_blank" rel="noopener" class="hero-social-icon" title="LinkedIn">
            <img src="/social/linkedin.png" alt="LinkedIn" width="20" height="20" />
          </a>
          <a href="https://x.com/AxomiyaIndie" target="_blank" rel="noopener" class="hero-social-icon" title="X">
            <img src="/social/x.png" alt="X" width="20" height="20" />
          </a>
          <a href="https://www.facebook.com/AxomiyaIndie" target="_blank" rel="noopener" class="hero-social-icon" title="Facebook">
            <img src="/social/facebook.png" alt="Facebook" width="20" height="20" />
          </a>
          <a href="https://www.youtube.com/@axomiyaindie" target="_blank" rel="noopener" class="hero-social-icon" title="YouTube">
            <img src="/social/youtube.png" alt="YouTube" width="20" height="20" />
          </a>
        </div>
      </div>
    </div>

  </div>

  <!-- Navigation -->
  <div class="flex gap-4 mt-8 justify-center items-center">
    <button id="hero-prev" class="bg-white border border-card-border text-text-main w-14 h-14 rounded-full cursor-pointer flex items-center justify-center transition-all duration-300 hover:scale-110 hover:border-meta-blue hover:text-meta-blue shadow-md">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    </button>

    <div class="flex gap-2">
      <div class="hero-dot w-2 h-2 rounded-full bg-text-muted transition-all duration-300"></div>
      <div class="hero-dot w-2 h-2 rounded-full bg-text-muted opacity-30 transition-all duration-300"></div>
      <div class="hero-dot w-2 h-2 rounded-full bg-text-muted opacity-30 transition-all duration-300"></div>
    </div>

    <button id="hero-next" class="bg-white border border-card-border text-text-main w-14 h-14 rounded-full cursor-pointer flex items-center justify-center transition-all duration-300 hover:scale-110 hover:border-meta-blue hover:text-meta-blue shadow-md">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
  </div>
</section>

<style>
  .hero-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.2s ease;
    backdrop-filter: blur(4px);
  }
  .hero-social-icon:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px) scale(1.05);
  }
  .hero-social-icon img { opacity: 0.9; transition: opacity 0.2s ease; }
  .hero-social-icon:hover img { opacity: 1; }
</style>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  const prevBtn = document.getElementById('hero-prev');
  const nextBtn = document.getElementById('hero-next');
  let currentSlide = 0;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      const el = slide as HTMLElement;
      if (i === index) {
        el.classList.remove('hidden');
        el.classList.add('flex');
        setTimeout(() => {
          el.classList.remove('opacity-0');
          el.classList.add('opacity-100');
        }, 50);
      } else {
        el.classList.remove('opacity-100');
        el.classList.add('opacity-0');
        setTimeout(() => {
          el.classList.add('hidden');
          el.classList.remove('flex');
        }, 400);
      }
    });

    dots.forEach((dot, i) => {
      const el = dot as HTMLElement;
      if (i === index) {
        el.style.background = '#0064e0'; // meta-blue
        el.style.opacity = '1';
        el.style.width = '24px';
        el.style.borderRadius = '4px';
      } else {
        el.style.background = '#65676b'; // text-muted
        el.style.opacity = '0.3';
        el.style.width = '8px';
        el.style.borderRadius = '50%';
      }
    });
  }

  showSlide(0);

  prevBtn?.addEventListener('click', () => {
    currentSlide = (currentSlide - 1 + slides.length) % slides.length;
    showSlide(currentSlide);
  });

  nextBtn?.addEventListener('click', () => {
    currentSlide = (currentSlide + 1) % slides.length;
    showSlide(currentSlide);
  });
</script>