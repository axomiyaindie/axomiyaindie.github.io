---
export interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const prefix = lang === 'as' ? '/as' : '';
const toggleHref = lang === 'as' ? '/' : '/as/';
const toggleLabel = lang === 'as' ? 'English' : 'অসমীয়া';
---
<header style="position: sticky; top: 0; z-index: 100; border-bottom: 1px solid var(--card-border); background: var(--nav-bg); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);">
  <div style="max-width: 1100px; margin: 0 auto; padding: 1rem 1.25rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
    
    <!-- Logo + Name -->
    <a href={lang === 'as' ? '/as/' : '/'} style="display: flex; align-items: center; gap: 0.65rem; text-decoration: none; flex-shrink: 0;">
      <img src="/logo.png" alt="Axomiya Indie" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;" />
      <span style="font-size: clamp(1.1rem, 3vw, 1.3rem); font-weight: 800; letter-spacing: -0.5px; color: var(--text-main);">Axomiya Indie</span>
    </a>

    <!-- Nav + Toggle -->
    <div style="display: flex; align-items: center; gap: 1.5rem;">
      <nav style="display: flex; gap: 1.5rem; align-items: center;">
        <a href={`${prefix}/projects`} style="color: var(--text-main); text-decoration: none; font-size: 0.95rem; font-weight: 600; transition: color 0.2s;">
          {lang === 'as' ? 'প্ৰকল্প' : 'Projects'}
        </a>
        <a href={`${prefix}/blog`} style="color: var(--text-main); text-decoration: none; font-size: 0.95rem; font-weight: 600; transition: color 0.2s;">
          {lang === 'as' ? 'ব্লগ' : 'Blog'}
        </a>
      </nav>

      <!-- Language Switch Link -->
      <a href={toggleHref} style="background: var(--accent); color: white; border: none; padding: 0.5rem 1rem; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 0.9rem; white-space: nowrap; transition: background 0.2s; text-decoration: none; display: inline-block;">
        {toggleLabel}
      </a>
    </div>
  </div>
</header>
