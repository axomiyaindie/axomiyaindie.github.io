---
---
<header style="position: sticky; top: 0; z-index: 100; border-bottom: 1px solid var(--card-border); background: var(--nav-bg); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);">
  <div style="max-width: 1100px; margin: 0 auto; padding: 1rem 1.25rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
    
    <!-- Logo + Name -->
    <a href="/" style="display: flex; align-items: center; gap: 0.65rem; text-decoration: none; flex-shrink: 0;">
      <img src="/logo.png" alt="Axomiya Indie" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;" />
      <span style="font-size: clamp(1.1rem, 3vw, 1.3rem); font-weight: 800; letter-spacing: -0.5px; color: var(--text-main);">Axomiya Indie</span>
    </a>

    <!-- Nav + Toggle -->
    <div style="display: flex; align-items: center; gap: 1.5rem;">
      <nav style="display: flex; gap: 1.5rem; align-items: center;">
        <a href="/projects" style="color: var(--text-main); text-decoration: none; font-size: 0.95rem; font-weight: 600; transition: color 0.2s;">
          <span class="en-text">Projects</span><span class="as-text">প্ৰকল্প</span>
        </a>
        <a href="/blog" style="color: var(--text-main); text-decoration: none; font-size: 0.95rem; font-weight: 600; transition: color 0.2s;">
          <span class="en-text">Blog</span><span class="as-text">ব্লগ</span>
        </a>
      </nav>

      <!-- Meta-Style Blue Button for Language Toggle -->
      <button id="lang-toggle" style="background: var(--accent); color: white; border: none; padding: 0.5rem 1rem; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 0.9rem; white-space: nowrap; transition: background 0.2s;">
        <span class="en-text">অসমীয়া</span>
        <span class="as-text">English</span>
      </button>
    </div>
  </div>
</header>