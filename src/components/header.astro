---
export interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;

const prefix = lang === 'as' ? '/as' : '';

let currentPath = Astro.url.pathname;

let toggleHref = '/';
if (lang === 'en') {
  toggleHref = `/as${currentPath}`;
} else {
  toggleHref = currentPath.replace(/^\/as/, '') || '/';
}
if (!toggleHref.endsWith('/') && !toggleHref.includes('.')) {
  toggleHref += '/';
}

const toggleLabel = lang === 'as' ? 'English' : 'অসমীয়া';
---
<header class="sticky top-0 z-50 border-b border-card-border bg-nav-bg backdrop-blur-md">
  <div class="max-w-[1100px] mx-auto px-5 py-4 flex justify-between items-center gap-4">
    
    <a href={lang === 'as' ? '/as/' : '/'} class="flex items-center gap-2.5 no-underline shrink-0">
      <img src="/logo.png" alt="Axomiya Indie" class="w-8 h-8 rounded-full object-cover" />
      <span class="text-lg md:text-xl font-extrabold tracking-tight text-text-main">Axomiya Indie</span>
    </a>

    <div class="flex items-center gap-6">
      <nav class="flex gap-6 items-center">
        <a href={`${prefix}/projects/`} class="text-text-main no-underline text-[0.95rem] font-semibold hover:text-meta-blue transition-colors">
          {lang === 'as' ? 'প্ৰকল্প' : 'Projects'}
        </a>
        <a href={`${prefix}/blog/`} class="text-text-main no-underline text-[0.95rem] font-semibold hover:text-meta-blue transition-colors">
          {lang === 'as' ? 'ব্লগ' : 'Blog'}
        </a>
      </nav>

      <a href={toggleHref} class="bg-meta-blue text-white px-4 py-2 rounded-lg font-semibold text-sm whitespace-nowrap hover:bg-meta-blue-hover transition-colors no-underline">
        {toggleLabel}
      </a>
    </div>
  </div>
</header>