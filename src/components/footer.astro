---
export interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const prefix = lang === 'as' ? '/as' : '';
---
<footer class="border-t border-card-border py-12 px-5 mt-auto bg-gray-50">
  <div class="max-w-[1100px] mx-auto flex flex-col gap-8">
    
    <!-- Top Row: Brand + Text Links -->
    <div class="flex flex-wrap justify-between items-start gap-8">
      
      <!-- Brand / Bio -->
      <div class="max-w-[400px]">
        <a href={lang === 'as' ? '/as/' : '/'} class="flex items-center gap-3 no-underline mb-4">
          <img src="/logo.png" alt="Axomiya Indie" class="w-10 h-10 rounded-full object-cover" />
          <span class="text-xl font-extrabold text-text-main">Axomiya Indie</span>
        </a>
        <p class="m-0 text-text-muted text-[0.95rem] leading-relaxed">
          {lang === 'as'
            ? 'AI আৰু টেকৰ জৰিয়তে অসমত সকলোলৈ সমানভাৱে তথ্য পোহৰাবলৈ কাম কৰি আছোঁ।'
            : 'Using AI and technology to ensure every mind in Assam has equal access to knowledge.'}
        </p>
      </div>

      <!-- Socials Column -->
      <div class="flex flex-col gap-3">
        <h4 class="m-0 font-bold text-text-main text-base">Socials</h4>
        <a href="https://github.com/axomiyaindie" target="_blank" rel="noopener" class="text-text-muted hover:text-meta-blue no-underline text-[0.95rem] transition-colors">GitHub</a>
        <a href="https://www.linkedin.com/in/axomiyaindie/" target="_blank" rel="noopener" class="text-text-muted hover:text-meta-blue no-underline text-[0.95rem] transition-colors">LinkedIn</a>
        <a href="https://x.com/AxomiyaIndie" target="_blank" rel="noopener" class="text-text-muted hover:text-meta-blue no-underline text-[0.95rem] transition-colors">X (Twitter)</a>
      </div>

      <!-- More Column -->
      <div class="flex flex-col gap-3">
        <h4 class="m-0 font-bold text-text-main text-base">More</h4>
        <a href="https://www.youtube.com/@axomiyaindie" target="_blank" rel="noopener" class="text-text-muted hover:text-meta-blue no-underline text-[0.95rem] transition-colors">YouTube</a>
        <a href="https://www.facebook.com/AxomiyaIndie" target="_blank" rel="noopener" class="text-text-muted hover:text-meta-blue no-underline text-[0.95rem] transition-colors">Facebook</a>
        <a href={`${prefix}/about`} class="text-text-muted hover:text-meta-blue no-underline text-[0.95rem] transition-colors">About</a>
      </div>

    </div>

    <!-- Bottom Bar: Copyright -->
    <div class="border-t border-card-border pt-6 flex justify-between items-center flex-wrap gap-4 text-[0.85rem] text-text-muted">
      <span>© 2026 Axomiya Indie. All rights reserved.</span>
    </div>

  </div>
</footer>