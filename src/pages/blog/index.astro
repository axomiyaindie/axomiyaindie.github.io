---
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

const allBlogs = (await getCollection('blog', (p) => p.id.startsWith('en/')))
  .map(p => ({ ...p, slug: p.id.replace('en/', '') }))
  .sort((a, b) => {
    const dateA = a.slug.substring(0, 8).replace(/-/g, '');
    const dateB = b.slug.substring(0, 8).replace(/-/g, '');
    return dateB.localeCompare(dateA);
  });
---

<Layout title="All Blog Posts | Axomiya Indie" lang="en">
  <section class="py-16">
    <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-text-main mb-4">All Writing</h1>
    <p class="text-text-muted m-0 text-lg">Thoughts, tutorials, and updates.</p>
  </section>

  <div class="grid gap-6">
    {allBlogs.map((post) => (
      <a href={`/blog/${post.slug}/`} class="blog-card block bg-card-bg border border-card-border rounded-xl p-6 no-underline text-inherit transition-shadow hover:shadow-md">
        <div class="flex flex-col gap-5">
          <img src={post.data.image || '/blog/default-blog.png'} alt={`${post.data.title} cover`} class="w-full aspect-video object-cover rounded-lg" />
          <div>
            <h3 class="m-0 mb-2 text-xl md:text-2xl font-bold text-text-main">{post.data.title}</h3>
            <p class="m-0 text-text-muted text-base leading-relaxed">{post.data.description}</p>
          </div>
        </div>
      </a>
    ))}
  </div>
</Layout>