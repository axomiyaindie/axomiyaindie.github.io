---
import Layout from '../../layouts/layout.astro';
import { getCollection, render } from 'astro:content';
import { execSync } from 'child_process';
import { formatDate } from '../../utils/formatdate';

export async function getStaticPaths() {
  const blogs = await getCollection('blog', (p) => p.id.startsWith('en/'));
  return blogs.map(post => ({
    params: { slug: post.id.replace('en/', '') },
    props: { post },
  }));
}

function getFileDates(id: string) {
  try {
    const filePath = `src/content/blog/${id}.md`;
    
    const firstCommit = execSync(`git log --diff-filter=A --follow --format=%cd --date=format:%Y-%m-%d -1 -- "${filePath}"`, { encoding: 'utf-8' }).trim();
    const lastCommit = execSync(`git log -1 --format=%cd --date=format:%Y-%m-%d -- "${filePath}"`, { encoding: 'utf-8' }).trim();
    const commitCount = parseInt(execSync(`git rev-list --count HEAD -- "${filePath}"`, { encoding: 'utf-8' }).trim());

    return { 
      published: formatDate(firstCommit || lastCommit), 
      updated: formatDate(lastCommit),
      hasBeenUpdated: commitCount > 1
    };
  } catch { 
    return { published: "N/A", updated: "N/A", hasBeenUpdated: false }; 
  }
}

const { post } = Astro.props;
const { Content } = await render(post);
const dates = getFileDates(post.id);
const headerImage = post.data.image;
const isUpdated = dates.hasBeenUpdated;
const slug = post.id.replace('en/', '');
---

<Layout 
  title={`${post.data.title} | Axomiya Indie`} 
  description={post.data.description}
  image={`https://axomiyaindie.github.io/og/blog/${slug}.png`}
  lang="en"
>
  <article class="max-w-[800px] mx-auto py-8">
    <a href="/blog" class="text-text-muted no-underline text-sm inline-block mb-8 hover:text-meta-blue transition-colors">← All Posts</a>

    {headerImage && (
      <div class="rounded-2xl overflow-hidden border border-card-border mb-10">
        <img src={headerImage} alt={`${post.data.title} cover`} class="w-full aspect-video object-cover block" />
      </div>
    )}

    <header class="mb-6">
      <h1 class="m-0 mb-4 text-3xl md:text-4xl font-extrabold leading-tight tracking-tight">{post.data.title}</h1>
      <p class="m-0 text-text-muted text-lg leading-relaxed">{post.data.description}</p>
    </header>

    <div class="flex gap-3 flex-wrap mb-10 text-sm">
      {isUpdated ? (
        <span class="text-text-muted bg-gray-100 px-3 py-1.5 rounded-full font-semibold">
          Updated on {dates.updated}
        </span>
      ) : (
        <span class="text-meta-blue bg-meta-blue/10 px-3 py-1.5 rounded-full font-semibold">
          Published on {dates.published}
        </span>
      )}
    </div>

    <div class="prose">
      <Content />
    </div>

    {post.data.link && (
      <div class="mt-12 pt-6 border-t border-card-border">
        <a href={post.data.link} target="_blank" rel="noopener" class="text-meta-blue no-underline font-semibold hover:underline">
          External link →
        </a>
      </div>
    )}
  </article>
</Layout>