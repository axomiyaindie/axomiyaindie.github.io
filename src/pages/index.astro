---
import Layout from '../layouts/layout.astro';
import { getCollection } from 'astro:content';
import { execSync } from 'child_process';
import { formatDate } from '../utils/formatdate';

// Get the FIRST commit date (Published) and LATEST commit date (Updated) for a file
function getFileDates(collection: string, id: string) {
  try {
    const filePath = `src/content/${collection}/${id}.md`;
    
    const firstCommit = execSync(
      `git log --diff-filter=A --follow --format=%cd --date=format:%Y-%m-%d -1 -- "${filePath}"`,
      { encoding: 'utf-8' }
    ).trim();
    
    const lastCommit = execSync(
      `git log -1 --format=%cd --date=format:%Y-%m-%d -- "${filePath}"`,
      { encoding: 'utf-8' }
    ).trim();

    return {
      published: formatDate(firstCommit || lastCommit),
      updated: formatDate(lastCommit),
    };
  } catch {
    return { published: "N/A", updated: "N/A" };
  }
}

// Process Projects
const projects = (await getCollection('projects')).map(p => ({
  ...p,
  ...getFileDates('projects', p.id)
})).sort((a, b) => {
  const aDate = a.updated.split('-').reverse().join('-');
  const bDate = b.updated.split('-').reverse().join('-');
  return new Date(bDate).getTime() - new Date(aDate).getTime();
});

// Process Blogs
const blogs = (await getCollection('blog')).map(p => ({
  ...p,
  ...getFileDates('blog', p.id)
})).sort((a, b) => {
  const aDate = a.updated.split('-').reverse().join('-');
  const bDate = b.updated.split('-').reverse().join('-');
  return new Date(bDate).getTime() - new Date(aDate).getTime();
});

// Find the latest update across the whole site
const siteLastUpdated = blogs.length > 0 ? blogs[0].updated : (projects.length > 0 ? projects[0].updated : "N/A");
---