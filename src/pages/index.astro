---
import { getCollection } from 'astro:content';
const allProjects = await getCollection('projects');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Axomiya Indie | Projects</title>
    <meta name="description" content="Building for Assam, for the Future. A list of my projects." />
    
    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://axomiyaindie.github.io/" />
    <meta property="og:title" content="Axomiya Indie | Building for Assam" />
    <meta property="og:description" content="Independent developer building AI-first tools and education platforms." />
    <meta property="og:image" content="https://axomiyaindie.github.io/og-image.png" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://axomiyaindie.github.io/" />
    <meta property="twitter:title" content="Axomiya Indie | Building for Assam" />
    <meta property="twitter:description" content="Independent developer building AI-first tools and education platforms." />
    <meta property="twitter:image" content="https://axomiyaindie.github.io/og-image.png" />

    <style is:global>
      :root {
        --bg: #09090b;
        --text-main: #f4f4f5;
        --text-muted: #a1a1aa;
        --accent: #7C4DFF;
        --accent-glow: rgba(124, 77, 255, 0.4);
        --card-bg: #18181b;
        --card-border: #27272a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; padding: 0;
        background-color: var(--bg);
        color: var(--text-main);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        display: flex; flex-direction: column; min-height: 100vh;
        line-height: 1.6;
      }
      .container { max-width: 900px; margin: 0 auto; padding: 2rem; flex: 1; width: 100%; }
      
      /* Bilingual Toggle Logic */
      .en-text, .as-text { transition: opacity 0.3s ease; }
      .as-text { display: none; }
      body.lang-as .en-text { display: none; }
      body.lang-as .as-text { display: block; }
      span.as-text { display: none; }
      body.lang-as span.en-text { display: none; }
      body.lang-as span.as-text { display: inline; }
      
      /* Project Card Hover */
      .project-card:hover {
        border-color: var(--accent) !important;
        transform: translateY(-4px);
        box-shadow: 0 10px 30px -10px var(--accent-glow);
      }
      .project-card:hover .glow { opacity: 1 !important; }

      /* Social Icon Hover */
      .social-icon {
        transition: all 0.3s ease;
        opacity: 0.7;
      }
      .social-icon:hover {
        opacity: 1;
        transform: translateY(-3px) scale(1.1);
        filter: drop-shadow(0 0 8px var(--accent));
      }
      .social-icon:hover img[alt="LinkedIn"] { content: url("https://cdn.simpleicons.org/linkedin/0077B5"); }
      .social-icon:hover img[alt="X"] { content: url("https://cdn.simpleicons.org/x/ffffff"); }
    </style>
  </head>
  <body>
    <header style="border-bottom: 1px solid var(--card-border); padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; background: rgba(9, 9, 11, 0.8); backdrop-filter: blur(10px); z-index: 100;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <img src="/logo.png" alt="Axomiya Indie Logo" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent);" />
        <h1 style="margin: 0; font-size: 1.5rem; letter-spacing: -0.5px; background: linear-gradient(90deg, #00E1FF, #7C4DFF); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Axomiya Indie</h1>
      </div>
      <button id="lang-toggle" style="background: transparent; color: var(--text-main); border: 1px solid var(--card-border); padding: 0.5rem 1rem; border-radius: 20px; cursor: pointer; font-weight: 600; font-size: 0.9rem; transition: all 0.2s;">
        <span class="en-text">🇮🇳 অসমীয়া</span>
        <span class="as-text">🇬🇧 English</span>
      </button>
    </header>

    <main class="container">
      <section style="text-align: center; margin-bottom: 4rem; padding-top: 2rem;">
        <h2 style="font-size: 2.5rem; margin-bottom: 1rem; line-height: 1.2;" class="en-text">Building for Assam,<br/>for the Future.</h2>
        <h2 style="font-size: 2.5rem; margin-bottom: 1rem; line-height: 1.2;" class="as-text">অসমৰ বাবে,<br/>ভৱিষ্যতৰ বাবে।</h2>
        <p style="color: var(--text-muted); font-size: 1.2rem; max-width: 600px; margin: 0 auto;" class="en-text">Independent developer building AI-first tools and education platforms.</p>
        <p style="color: var(--text-muted); font-size: 1.2rem; max-width: 600px; margin: 0 auto;" class="as-text">AI-চালিত সঁজুলি আৰু শৈক্ষিক প্লেটফৰ্ম নিৰ্মাণ কৰা এজন স্বতন্ত্ৰ ডেভেলপাৰ।</p>
      </section>

      <section>
        <h3 style="font-size: 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid var(--card-border); padding-bottom: 1rem;">
          <span class="en-text">My Projects</span>
          <span class="as-text">মোৰ প্ৰকল্পসমূহ</span>
        </h3>
        <div style="display: grid; gap: 1.5rem;">
          {allProjects.map((project) => (
            <a href={project.data.link} target="_blank" rel="noopener" class="project-card" style="display: block; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 12px; padding: 1.5rem; text-decoration: none; color: inherit; transition: all 0.3s ease; position: relative; overflow: hidden;">
              <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at top right, var(--accent-glow), transparent 50%); opacity: 0; transition: opacity 0.3s ease; pointer-events: none;" class="glow"></div>
              <div style="position: relative; z-index: 1; display: flex; align-items: flex-start; gap: 1.25rem;">
                <img src={project.data.logo} alt={`${project.data.title} logo`} style="width: 64px; height: 64px; border-radius: 12px; object-fit: cover; border: 1px solid var(--card-border); background: #0d0d10; flex-shrink: 0;" />
                <div style="flex: 1; min-width: 0;">
                  <h4 style="margin: 0 0 0.5rem 0; font-size: 1.4rem; color: var(--text-main);">
                    <span class="en-text">{project.data.title}</span>
                    <span class="as-text">{project.data.title_as}</span>
                  </h4>
                  <p style="margin: 0; color: var(--text-muted); line-height: 1.6;">
                    <span class="en-text">{project.data.description}</span>
                    <span class="as-text">{project.data.description_as}</span>
                  </p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer style="border-top: 1px solid var(--card-border); padding: 2rem; text-align: center; color: var(--text-muted); margin-top: auto;">
      <p style="margin-bottom: 1.5rem; max-width: 600px; margin-left: auto; margin-right: auto;">
        <span class="en-text">Using AI and technology to ensure every mind in Assam has equal access to knowledge.</span>
        <span class="as-text">AI আৰু টেকৰ জৰিয়তে অসমত সকলোলৈ সমানভাৱে তথ্য পোহৰাবলৈ কাম কৰি আছোঁ।</span>
      </p>
      
      <div style="display: flex; justify-content: center; gap: 2rem; align-items: center;">
        <a href="https://github.com/axomiyaindie" target="_blank" rel="noopener" class="social-icon" title="GitHub">
          <img src="https://cdn.simpleicons.org/github/f4f4f5" alt="GitHub" width="28" height="28" />
        </a>
        <a href="https://www.linkedin.com/in/axomiyaindie/" target="_blank" rel="noopener" class="social-icon" title="LinkedIn">
          <img src="https://cdn.simpleicons.org/linkedin/f4f4f5" alt="LinkedIn" width="28" height="28" />
        </a>
        <a href="https://x.com/AxomiyaIndie" target="_blank" rel="noopener" class="social-icon" title="X (Twitter)">
          <img src="https://cdn.simpleicons.org/x/f4f4f5" alt="X" width="28" height="28" />
        </a>
        <a href="https://www.facebook.com/share/17gMFEg3Y6/" target="_blank" rel="noopener" class="social-icon" title="Facebook">
          <img src="https://cdn.simpleicons.org/facebook/f4f4f5" alt="Facebook" width="28" height="28" />
        </a>
      </div>
    </footer>

    <script>
      const toggleBtn = document.getElementById('lang-toggle');
      toggleBtn.addEventListener('click', () => {
        document.body.classList.toggle('lang-as');
      });
    </script>
  </body>
</html>