---
import { getCollection } from 'astro:content';
const allProjects = await getCollection('projects');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Axomiya Indie | Projects</title>
    <meta name="description" content="Building for Assam, for the Future. A list of my projects." />
  </head>
  <body style="background: #0d1117; color: #c9d1d9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; padding: 3rem; max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; justify-content: center; min-height: 80vh;">
    <header style="margin-bottom: 3rem;">
      <h1 style="color: #00E1FF; font-size: 2.5rem; margin-bottom: 0.5rem;">Axomiya Indie</h1>
      <p style="color: #8b949e; font-size: 1.1rem; margin: 0;">Building for Assam, for the Future.</p>
    </header>
    
    <main>
      <h2 style="font-size: 1.2rem; color: #c9d1d9; margin-bottom: 1.5rem; border-bottom: 1px solid #30363d; padding-bottom: 0.5rem;">My Projects</h2>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        {allProjects.map((project) => (
          <a href={project.data.link} style="border: 1px solid #30363d; padding: 1.5rem; border-radius: 8px; text-decoration: none; color: inherit; transition: border-color 0.2s;">
            <h3 style="color: #7C4DFF; margin: 0 0 0.5rem 0; font-size: 1.4rem;">{project.data.title}</h3>
            <p style="margin: 0; color: #8b949e; line-height: 1.5;">{project.data.description}</p>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>
