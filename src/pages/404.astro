---
import Layout from '../layouts/layout.astro';
import { getCollection } from 'astro:content';

const path = Astro.url.pathname;
const isAssamese = path.startsWith('/as/');

// Extract the slug from the URL
const cleanPath = path.replace(/^\/as/, '').replace(/^\/|\/$/g, '');
const parts = cleanPath.split('/');

let otherLangPath: string | null = null;

// Only try to find the counterpart if it's a detail page (blog/[slug] or projects/[slug])
if (parts.length === 2 && (parts[0] === 'blog' || parts[0] === 'projects')) {
  const [section, slug] = parts;
  const otherLang = isAssamese ? 'en' : 'as';
  
  const otherLangCollection = await getCollection(section as 'blog' | 'projects', (p) => p.id === `${otherLang}/${slug}`);
  
  if (otherLangCollection.length > 0) {
    otherLangPath = isAssamese ? `/${section}/${slug}/` : `/as/${section}/${slug}/`;
  }
}

// UI Text
const title = isAssamese ? 'পৃষ্ঠাটো পোৱা নগ’ল' : 'Page Not Found';
const message = otherLangPath
  ? (isAssamese 
      ? 'এই পৃষ্ঠাটোৰ অসমীয়া সংস্কৰণ এতিয়াও উপলব্ধ নহয়।' 
      : 'This page is not available in English yet.')
  : (isAssamese
      ? 'এই পৃষ্ঠাটো নাই।'
      : 'This page does not exist.');
const subMessage = otherLangPath
  ? (isAssamese
      ? 'আপুনি ইংৰাজী সংস্কৰণত পঢ়িব পাৰে, বা আমাক অনুবাদ কৰাত সহায় কৰিব পাৰে।'
      : 'You can view the Assamese version, or help us translate it on GitHub.')
  : (isAssamese
      ? 'আপুনি ঘৰলৈ উভতি যাব পাৰে বা GitHub-ত সহায় কৰিব পাৰে।'
      : 'You can go back home or help us on GitHub.');

const btnOtherLang = otherLangPath
  ? (isAssamese ? 'Read in English' : 'অসমীয়াত পঢ়ক (Read in Assamese)')
  : null;
const btnHome = isAssamese ? 'ঘৰলৈ যাওক (Home)' : 'Back to Home';

const repoUrl = "https://github.com/axomiyaindie/axomiyaindie.github.io";
---

<Layout title={title} lang={isAssamese ? 'as' : 'en'}>
  <section style="text-align: center; padding: 6rem 2rem; max-width: 600px; margin: 0 auto;">
    <h1 style="font-size: 4rem; font-weight: 800; color: var(--accent); margin: 0 0 1rem 0;">404</h1>
    <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--text-main);">{title}</h2>
    <p style="color: var(--text-muted); margin-bottom: 0.5rem; font-size: 1.1rem;">{message}</p>
    <p style="color: var(--text-muted); margin-bottom: 2rem; font-size: 1rem;">{subMessage}</p>
    
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem;">
      {btnOtherLang && (
        <a href={otherLangPath!} style="display: inline-block; background: var(--accent); color: white; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 600;">
          {btnOtherLang}
        </a>
      )}
      
      <a href={isAssamese ? '/as/' : '/'} style="display: inline-block; background: #f0f2f5; color: var(--text-main); padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 600;">
        {btnHome}
      </a>
    </div>

    <!-- GitHub Contribution Section -->
    <div style="border-top: 1px solid var(--card-border); padding-top: 2rem; margin-top: 2rem;">
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem;">
        {isAssamese 
          ? "আমাক অনুবাদ কৰাত সহায় কৰক, অৱদান আগবঢ়াওক, বা কোনো ভুল ধৰা পেলালে জনাওক।" 
          : "Help us translate this page, contribute, or report any mistakes."}
      </p>
      <a href={repoUrl} target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 0.75rem; color: white; text-decoration: none; font-weight: 600; background: var(--text-main); padding: 0.75rem 1.5rem; border-radius: 8px; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
        <img src="/social/github.png" alt="GitHub" style="width: 20px; height: 20px; filter: brightness(0) invert(1);" />
        View Repository on GitHub
      </a>
    </div>
  </section>
</Layout>