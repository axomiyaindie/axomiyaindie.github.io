---
import Layout from '../../layouts/layout.astro';
import Hero from '../../components/hero.astro';
import { getCollection } from 'astro:content';
import { execSync } from 'child_process';
import { formatDate } from '../../utils/formatdate';

function getFileDates(collection: string, id: string) {
  try {
    const filePath = `src/content/${collection}/${id}.md`;
    const firstCommit = execSync(`git log --diff-filter=A --follow --format=%cd --date=format:%Y-%m-%d -1 -- "${filePath}"`, { encoding: 'utf-8' }).trim();
    const lastCommit = execSync(`git log -1 --format=%cd --date=format:%Y-%m-%d -- "${filePath}"`, { encoding: 'utf-8' }).trim();
    return { published: formatDate(firstCommit || lastCommit), updated: formatDate(lastCommit) };
  } catch { return { published: "N/A", updated: "N/A" }; }
}

const allProjects = (await getCollection('projects', (entry) => entry.id.startsWith('as/')))
  .map(p => ({ ...p, slug: p.id.replace('as/', ''), ...getFileDates('projects', p.id) }))
  .sort((a, b) => new Date(b.updated.split('-').reverse().join('-')).getTime() - new Date(a.updated.split('-').reverse().join('-')).getTime());
const latestProjects = allProjects.slice(0, 3);

const allBlogs = (await getCollection('blog', (entry) => entry.id.startsWith('as/')))
  .map(p => ({ ...p, slug: p.id.replace('as/', ''), ...getFileDates('blog', p.id) }))
  .sort((a, b) => new Date(b.updated.split('-').reverse().join('-')).getTime() - new Date(a.updated.split('-').reverse().join('-')).getTime());
const latestBlogs = allBlogs.slice(0, 3);

const siteLastUpdated = allBlogs.length > 0 ? allBlogs[0].updated : (allProjects.length > 0 ? allProjects[0].updated : "N/A");
---

<Layout title="Axomiya Indie" lang="as">
  
  <Hero lang="as" />

  <!-- শেহতীয়া প্ৰকল্প -->
  <section class="mb-20">
    <div class="flex justify-between items-baseline gap-4 mb-6 border-b border-card-border pb-4 flex-wrap">
      <h2 class="text-2xl md:text-3xl font-extrabold text-text-main m-0">শেহতীয়া প্ৰকল্প</h2>
      <a href="/as/projects" class="text-meta-blue no-underline text-base font-semibold hover:underline">সকলো →</a>
    </div>

    <div class="grid gap-6">
      {latestProjects.map((project) => (
        <a href={`/as/projects/${project.slug}/`} class="project-card block bg-card-bg border border-card-border rounded-xl p-6 no-underline text-inherit transition-shadow hover:shadow-md">
          <div class="flex gap-6 items-center">
            <img src={project.data.logo} alt={`${project.data.title} logo`} class="w-18 h-18 rounded-xl object-cover border border-card-border shrink-0" />
            <div class="flex-1 min-w-0">
              <h3 class="m-0 mb-2 text-xl md:text-2xl font-bold text-text-main">{project.data.title}</h3>
              <p class="m-0 text-text-muted text-base leading-relaxed">{project.data.description}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- শেহতীয়া লিখনি -->
  <section>
    <div class="flex justify-between items-baseline gap-4 mb-6 border-b border-card-border pb-4 flex-wrap">
      <h2 class="text-2xl md:text-3xl font-extrabold text-text-main m-0">শেহতীয়া লিখনি</h2>
      <a href="/as/blog" class="text-meta-blue no-underline text-base font-semibold hover:underline">সকলো →</a>
    </div>

    <div class="grid gap-6">
      {latestBlogs.map((post) => (
        <a href={`/as/blog/${post.slug}/`} class="blog-card block bg-card-bg border border-card-border rounded-xl p-6 no-underline text-inherit transition-shadow hover:shadow-md">
          <div class="flex flex-col gap-5">
            <img src={post.data.image || '/blog/default-blog.png'} alt={`${post.data.title} cover`} class="w-full aspect-video object-cover rounded-lg" />
            <div>
              <h3 class="m-0 mb-2 text-xl md:text-2xl font-bold text-text-main">{post.data.title}</h3>
              <p class="m-0 text-text-muted text-base leading-relaxed">{post.data.description}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <div class="text-center mt-20 pt-8 border-t border-card-border text-sm text-text-muted">
    শেষ আপডেট: <strong class="text-text-main">{siteLastUpdated}</strong>
  </div>
</Layout>