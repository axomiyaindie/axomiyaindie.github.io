---
import Layout from '../../../layouts/layout.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects', (p) => p.id.startsWith('as/')))
  .map(p => ({ ...p, slug: p.id.replace('as/', '') }))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Layout title="সকলো প্ৰকল্প | Axomiya Indie" lang="as">
  <section class="py-16">
    <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-text-main mb-4">সকলো প্ৰকল্প</h1>
    <p class="text-text-muted m-0 text-lg">মই এতিয়ালৈকে নিৰ্মাণ কৰা সকলো।</p>
  </section>

  <div class="grid gap-6">
    {allProjects.map((project) => (
      <a href={`/as/projects/${project.slug}/`} class="project-card block bg-card-bg border border-card-border rounded-xl p-6 no-underline text-inherit transition-shadow hover:shadow-md">
        <div class="flex gap-6 items-center">
          <img src={project.data.logo} alt={`${project.data.title} logo`} class="w-18 h-18 rounded-xl object-cover border border-card-border shrink-0" />
          <div class="flex-1 min-w-0">
            <h3 class="m-0 mb-2 text-xl md:text-2xl font-bold text-text-main">{project.data.title}</h3>
            <p class="m-0 text-text-muted text-base leading-relaxed">{project.data.description}</p>
          </div>
        </div>
      </a>
    ))}
  </div>
</Layout>