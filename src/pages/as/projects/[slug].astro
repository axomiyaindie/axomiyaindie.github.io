---
import Layout from '../../../layouts/layout.astro';
import Share from '../../../components/share.astro';
import { getCollection, render } from 'astro:content';
import { execSync } from 'child_process';
import { formatDate } from '../../../utils/formatdate';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => p.id.startsWith('as/'));
  return projects.map(project => ({
    params: { slug: project.id.replace('as/', '') },
    props: { project },
  }));
}

function getFileDates(id: string) {
  try {
    const filePath = `src/content/projects/${id}.md`;
    
    const firstCommit = execSync(`git log --diff-filter=A --follow --format=%cd --date=format:%Y-%m-%d -1 -- "${filePath}"`, { encoding: 'utf-8' }).trim();
    const lastCommit = execSync(`git log -1 --format=%cd --date=format:%Y-%m-%d -- "${filePath}"`, { encoding: 'utf-8' }).trim();
    const commitCount = parseInt(execSync(`git rev-list --count HEAD -- "${filePath}"`, { encoding: 'utf-8' }).trim());

    return { 
      published: formatDate(firstCommit || lastCommit), 
      updated: formatDate(lastCommit),
      hasBeenUpdated: commitCount > 1
    };
  } catch { 
    return { published: "N/A", updated: "N/A", hasBeenUpdated: false }; 
  }
}

const { project } = Astro.props;
const { Content } = await render(project);
const dates = getFileDates(project.id);
const isUpdated = dates.hasBeenUpdated;
const slug = project.id.replace('as/', '');
---

<Layout 
  title={`${project.data.title} | Axomiya Indie`} 
  description={project.data.description}
  image={`https://axomiyaindie.github.io/og/projects/${slug}.png`}
  lang="as"
>
  <article class="max-w-[800px] mx-auto py-8">
    <a href="/as/projects" class="text-text-muted no-underline text-sm inline-block mb-8 hover:text-meta-blue transition-colors">← সকলো প্ৰকল্প</a>

    {project.data.image && (
      <div class="rounded-2xl overflow-hidden border border-card-border mb-10">
        <img src={project.data.image} alt={`${project.data.title} cover`} class="w-full aspect-video object-cover block" />
      </div>
    )}

    <header class="flex flex-col gap-5 mb-6">
      <img src={project.data.logo} alt={`${project.data.title} logo`} class="w-22 h-22 rounded-2xl object-cover border-2 border-card-border bg-[#0d0d10]" />
      <div>
        <h1 class="m-0 mb-2 text-3xl md:text-4xl font-extrabold leading-tight tracking-tight">{project.data.title}</h1>
        <p class="m-0 text-text-muted text-lg leading-relaxed">{project.data.description}</p>
      </div>
    </header>

    <div class="flex gap-3 flex-wrap mb-10 text-sm">
      {isUpdated ? (
        <span class="text-text-muted bg-gray-100 px-3 py-1.5 rounded-full font-semibold">
          আপডেট কৰা হৈছে: {dates.updated}
        </span>
      ) : (
        <span class="text-meta-blue bg-meta-blue/10 px-3 py-1.5 rounded-full font-semibold">
          প্ৰকাশিত: {dates.published}
        </span>
      )}
    </div>

    <div class="mb-10">
      <a href={project.data.link} target="_blank" rel="noopener" class="inline-block bg-meta-blue text-white px-7 py-3 rounded-lg no-underline font-semibold text-[0.95rem] hover:bg-meta-blue-hover transition-colors">
        প্ৰকল্প চাওক →
      </a>
    </div>

    <div class="prose">
      <Content />
    </div>

    <Share 
      title={project.data.title} 
      url={`https://axomiyaindie.github.io/as/projects/${slug}/`} 
    />
  </article>
</Layout>